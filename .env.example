# Скопируйте в .env и подставьте реальное значение.
# Compose подхватывает .env автоматически.

# Внутренний FQDN сервера Exchange 2019 (upstream exch_ntlm)
EXCHANGE_FQDN=exchange.internal.example.com

# Необязательно: первый администратор NPM. Действует только при первом
# запуске на пустой базе; без них UI покажет мастер настройки (setup wizard).
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=changeme

# Необязательно: автоматически создать Proxy Host для Exchange через API NPM
# (без ручной вставки Advanced-конфига). Требует INITIAL_ADMIN_* выше.
# NPM_SEED_PROXY_HOST=true
# OWA_FQDN=owa.example.com
# Если пуст — Proxy Host создаётся только с OWA_FQDN (без autodiscover)
# AUTODISCOVER_FQDN=autodiscover.example.com

# Необязательно: отключить выгрузку IP-диапазонов AWS/Cloudflare при старте.
# Она выполняется синхронно ДО старта backend'а: если исходящий HTTPS до
# amazonaws.com/cloudflare.com висит (файрвол), UI долго показывает
# "The API is not healthy". Для Exchange-сценария выгрузка бесполезна.
# IP_RANGES_FETCH_ENABLED=false
