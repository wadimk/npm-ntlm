# =========================================================================
# Шаблон Advanced-конфига Proxy Host для Exchange 2019.
#
# При NPM_SEED_PROXY_HOST=true entrypoint сам рендерит его и создаёт
# Proxy Host через API NPM (см. seed-proxy-host.sh). Для ручной вставки
# (Proxy Host -> Advanced -> Custom Nginx Configuration, порт 81)
# замените плейсхолдеры:
#   ${OWA_FQDN}       -> ваш публичный FQDN для OWA
#   ${EXCHANGE_FQDN}  -> внутренний FQDN сервера Exchange 2019
# =========================================================================

keepalive_timeout 3h;
tcp_nodelay on;
client_max_body_size 3g;

# buffering and timeouts
proxy_request_buffering off;
proxy_buffering off;
proxy_read_timeout 3h;
proxy_send_timeout 3h;
proxy_connect_timeout 20s;

# NB: proxy_http_version 1.1 и proxy_set_header Connection здесь не задаём —
# NPM 2.16 уже генерирует их на уровне server {} (будет duplicate),
# а в NTLM location-блоках ниже они выставлены явно.

# standard headers
proxy_set_header Accept-Encoding "identity";

# pass request headers upstream, and allow key response headers back
proxy_pass_request_headers on;
proxy_pass_header WWW-Authenticate;
proxy_pass_header Authorization;

proxy_ssl_server_name on;

# ---------- Корень и служебное ----------

# Редирект с корня сразу на OWA. На autodiscover-хосте безвреден:
# клиенты Autodiscover ходят на /autodiscover/*, а не на /.
location = / {
    return 302 /owa;
}

# Health probe для мониторинга: GET /healthz -> 200 ok
location = /healthz {
    return 200 "ok";
    add_header Content-Type text/plain;
}

# Remote PowerShell снаружи не нужен — закрываем (best practice).
# Если Remote PS через этот прокси всё же требуется — удалите блок.
location /powershell {
    return 403;
}

# ---------- NTLM-backed services ----------

# Autodiscover
location ~* ^/(autodiscover|Autodiscover|AutoDiscover)/ {
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header Authorization $http_authorization;

  proxy_ssl_name ${EXCHANGE_FQDN};
  proxy_pass https://exch_ntlm;

  access_log /var/log/nginx/ntlm_access.log ntlm_log;
  error_log  /var/log/nginx/ntlm_error.log warn;
}

# EWS (включая mrsproxy.svc)
# NB: регистронезависимый regex (~*) обязателен — клиенты используют регистр
# из URL виртуальных каталогов Exchange (/EWS/, /OAB/ — в верхнем), а префиксные
# location в nginx case-sensitive. С префиксным /ews/ запросы /EWS/ уходили
# в дефолтный location без NTLM-привязки -> SEC_E_INVALID_TOKEN на Type-3.
location ~* ^/ews/ {
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header Authorization $http_authorization;

  proxy_ssl_name ${EXCHANGE_FQDN};
  proxy_pass https://exch_ntlm;

  access_log /var/log/nginx/ntlm_access.log ntlm_log;
  error_log  /var/log/nginx/ntlm_error.log warn;
}

# MAPI over HTTP
location ~* ^/mapi/ {
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header Proxy-Support "Session-Based-Authentication";
  proxy_set_header Authorization $http_authorization;

  proxy_ssl_name ${EXCHANGE_FQDN};
  proxy_pass https://exch_ntlm;

  access_log /var/log/nginx/ntlm_access.log ntlm_log;
  error_log  /var/log/nginx/ntlm_error.log warn;
}

# Outlook Anywhere RPC
location ~* ^/rpc {
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header Authorization $http_authorization;

  proxy_ssl_name ${EXCHANGE_FQDN};
  proxy_pass https://exch_ntlm;

  access_log /var/log/nginx/ntlm_access.log ntlm_log;
  error_log  /var/log/nginx/ntlm_error.log warn;
}

# ActiveSync
# NB: какое-то время эта локация проксировалась напрямую (минуя exch_ntlm)
# из-за 502 на RCA FolderSync — расследование показало, что модуль был
# невиновен: Exchange выполнял FolderSync ~20 с (отключённое наследование
# разрешений на учётке в AD, событие MSExchange ActiveSync), и запрос
# отсекался по таймауту. При медленном Exchange проверяйте IIS-лог
# (time-taken) и AD-права пользователя, а не модуль.
location ~* ^/microsoft-server-activesync {
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header Authorization $http_authorization;

  proxy_ssl_name ${EXCHANGE_FQDN};
  proxy_pass https://exch_ntlm;

  access_log /var/log/nginx/ntlm_access.log ntlm_log;
  error_log  /var/log/nginx/ntlm_error.log warn;
}

# OAB
location ~* ^/oab {
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header Authorization $http_authorization;

  proxy_ssl_name ${EXCHANGE_FQDN};
  proxy_pass https://exch_ntlm;

  access_log /var/log/nginx/ntlm_access.log ntlm_log;
  error_log  /var/log/nginx/ntlm_error.log warn;
}

# ---------- OWA (pass-through, без NTLM) ----------
# Host должен совпадать с URL виртуальных каталогов Exchange.
# Authorization обрезается — NTLM в OWA не проходит.

location /owa/ {
  proxy_set_header Host ${OWA_FQDN};
  proxy_set_header Authorization "";
  proxy_ssl_name ${EXCHANGE_FQDN};
  proxy_redirect off; # preserve Location headers from Exchange
  proxy_pass https://${EXCHANGE_FQDN};
}

# ECP — админка Exchange, снаружи закрыта (best practice).
# Чтобы открыть: удалите этот блок — тогда /ecp уйдёт в дефолтный location
# NPM и будет проксироваться на Exchange. Чтобы открыть только своим —
# замените return 403 на allow/deny плюс proxy-директивы как у /owa/ выше:
#   allow 203.0.113.0/24; deny all;
#   proxy_set_header Host ${OWA_FQDN};
#   proxy_set_header Authorization "";
#   proxy_ssl_name ${EXCHANGE_FQDN};
#   proxy_redirect off;
#   proxy_pass https://${EXCHANGE_FQDN};
location /ecp/ {
  return 403;
}
# Голый /ecp (без слэша) — тоже 403, иначе он уйдёт в дефолтный location
# и Exchange ответит 302, подтвердив наличие ECP.
location = /ecp {
  return 403;
}
